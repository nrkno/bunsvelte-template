{
    "name": "bun-svelte-template",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "bun run server.ts",
        "build": "bun build ./src/main.ts --outdir ./dist --target browser",
        "typecheck": "bunx svelte-check --tsconfig ./tsconfig.json",
        "test": "bun test",
        "format": "prettier --write ."
    },
    "dependencies": {
        "svelte": "^5.0.0",
        "bun-plugin-svelte": "latest"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.1"
    }
}